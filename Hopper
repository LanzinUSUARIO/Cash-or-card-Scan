local function getTraitEmojis(traits)
    if type(traits) ~= "table" or #traits == 0 then return "" end
    local emojis = {}; local seen = {}
    for _, t in ipairs(traits) do local emoji = TRAIT_EMOJIS[t]; if emoji and not seen[emoji] then seen[emoji]=true; table.insert(emojis, emoji) end end
    return table.concat(emojis, " ")
end
local function getRarityEmoji(value)
    if value >= 1e9   then return "🔶" end
    if value >= 500e6 then return "🟧" end
    if value >= 100e6 then return "🟦" end
    if value >= 50e6  then return "🟪" end
    if value >= 10e6  then return "🔹" end
    return ""
end
local function buildListText(results, targetOwner, skipName)
    local lines = {}; local count = 0
    for _, r in ipairs(results) do
        if r.name == skipName then continue end
        if count >= 20 then break end
        local line = getMutationEmoji(r.mutation)
        local traitStr = getTraitEmojis(r.traits)
        if traitStr ~= "" then line = line .. " " .. traitStr end
        line = line .. " · " .. r.name
        local re = getRarityEmoji(r.value)
        if re ~= "" then line = line .. " " .. re end
        line = line .. " — $" .. formatValue(r.value) .. "/s"
        if r.inDuel then line = line .. " ⚔️" end
        table.insert(lines, line); count = count + 1
    end
    if #lines == 0 then return "" end
    return table.concat(lines, "\n")
end
local function getBrainrotImage(name)
    local ok, result = pcall(function()
        local url = "https://stealabrainrot.fandom.com/api.php?action=query&titles=" .. HttpService:UrlEncode(name) .. "&prop=pageimages&piprop=original&format=json"
        local resp = http_request({ Url=url, Method="GET" })
        if resp and resp.StatusCode == 200 then
            local data = HttpService:JSONDecode(resp.Body)
            for _, page in pairs(data.query.pages) do if page.original and page.original.source then return page.original.source end end
        end
    end)
    return ok and result or nil
end
local function sendWebhook(url, name, value, mutation, listText, showFields, footer, ownerName, jobId, includeJoinLink, inDuel, pingHere, traits)
    if not url or url == "" then return end
    local imageUrl     = getBrainrotImage(name)
    local joinLink     = "https://liphyrdev.github.io/notifier/?placeId=109983668079237&gameInstanceId=" .. (jobId or CURRENT_JOB)
    local channelLabel = CHANNEL_NAMES[footer] or footer or "Notifier"
    local rarityEmoji  = getRarityEmoji(value)
    local mutEmoji     = getMutationEmoji(mutation)
    local traitStr     = getTraitEmojis(traits)
    local nameDisplay  = mutEmoji .. " · **" .. name .. "**"
    if rarityEmoji ~= "" then nameDisplay = nameDisplay .. " " .. rarityEmoji end
    if inDuel then nameDisplay = nameDisplay .. " ⚔️" end
    local traitLine    = (traitStr ~= "" and "\n" .. traitStr or "")
    local valueDisplay = "\n$" .. formatValue(value) .. "/s"
    local othersText   = ""
    if listText and listText ~= "" then othersText = "\n\n**Others**\n" .. listText end
    local description  = nameDisplay .. traitLine .. valueDisplay .. othersText
    local brasilia_time = os.date("!%d de %B de %Y às %H:%M", os.time() - 3 * 3600)
    local fields = {}
    if includeJoinLink then
        table.insert(fields, { ["name"]="Job ID", ["value"]="`"..(jobId or CURRENT_JOB).."`" })
        table.insert(fields, { ["name"]="​", ["value"]="[🔗 Click Here To Join!]("..joinLink..")" })
    end
    local embed = { ["title"]="Cash Or Card Notifier · "..channelLabel, ["color"]=EMBED_COLOR, ["description"]=description, ["fields"]=fields, ["footer"]={ ["text"]="Cash Or Card Notifier || "..brasilia_time.." | Made by Lanzin" } }
    if imageUrl and imageUrl ~= "" then embed["thumbnail"] = { ["url"]=imageUrl } end
    pcall(function()
        local body = { username="Cash Or Card Notifier", embeds={ embed } }
        if pingHere then body["content"] = "@here" end
        http_request({ Url=url, Method="POST", Headers={ ["Content-Type"]="application/json" }, Body=HttpService:JSONEncode(body) })
    end)
end

