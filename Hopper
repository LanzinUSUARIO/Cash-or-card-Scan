local function sendToRailway(name, value, mutation, traits, tier, ownerName, jobId, inDuel)
    local ok, body = pcall(function()
        return HttpService:JSONEncode({
            secret    = RAILWAY_SECRET,
            name      = name      or "Unknown",
            value     = value     or 0,
            mutation  = mutation  or "Normal",
            traits    = traits    or {},
            tier      = tier      or "MID",
            ownerName = ownerName or "?",
            jobId     = jobId     or "",
            placeId   = tostring(PLACE_ID),
            inDuel    = inDuel    or false,
            scanner   = LocalPlayer.Name,
        })
    end)
    if not ok then warn("Railway encode error:", body) return end
    local success, response = pcall(function()
        return http_request({
            Url     = RAILWAY_URL .. "/api/report",
            Method  = "POST",
            Headers = {
                ["Content-Type"]      = "application/json",
                ["X-CashCard-Client"] = RAILWAY_HEADER,
            },
            Body = body,
        })
    end)
    if success and response then
        print("📡 Railway OK:", name, "| Status:", response.StatusCode)
    else
        warn("📡 Railway FALHOU:", tostring(response))
    end
end

